Name: cockpit-diagnostics
Version: %{VERSION}
Release: 1%{?dist}
Summary: systemd and Linux diagnostics for Cockpit
License: LGPL-2.1-or-later

# Production JavaScript is prebuilt by `make dist` into dist/. The RPM
# installs those artifacts; it does not bundle node_modules or rebuild
# the frontend during rpmbuild.

Source0: %{name}-%{version}.tar.xz

BuildArch: noarch
BuildRequires: make
BuildRequires: gettext
%if 0%{?suse_version}
BuildRequires: appstream-glib
%else
BuildRequires: libappstream-glib
%endif

# Hard runtime: this is a Cockpit package that talks to systemd.
Requires: cockpit-bridge
Requires: systemd
# coredumpctl is typically in systemd; systemd-coredump stores crash files.
# The Crashes page degrades to an empty/unavailable state without it.
Recommends: systemd-coredump

%{NPM_PROVIDES}

%description
Cockpit application for current-boot systemd timing, systemd-analyze
plot, unit activation duration, the critical chain, currently failed
units, current-boot coredumps, conservative OOM and high-priority
kernel findings, systemd-analyze security (service sandboxing
exposure), and systemd-analyze verify (read-only unit-file checks).

It links to Cockpit Services and Logs instead of replacing them.
Security analysis is not a vulnerability scanner. Verification does
not edit units, reload systemd, or start services.

%prep
%autosetup -n %{name}

%build
# Bundle is already in dist/ from the source tarball.

%install
%make_install PREFIX=/usr

# drop source maps, they are large and just for debugging
find %{buildroot}%{_datadir}/cockpit/diagnostics/ -name '*.map' | xargs --no-run-if-empty rm --verbose

%check
if command -v appstream-util >/dev/null 2>&1; then
  appstream-util validate-relax --nonet %{buildroot}/%{_datadir}/metainfo/*
fi

%files
%doc README.md CHANGELOG.md
%license LICENSE dist/index.js.LEGAL.txt
%{_datadir}/cockpit/diagnostics/
%{_datadir}/metainfo/org.cockpit_project.diagnostics.metainfo.xml

%changelog
* Sun Sep 13 2026 cockpit-diagnostics contributors - 1.0.0-1
- First stable release of cockpit-diagnostics
