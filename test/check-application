#!/usr/bin/python3 -cimport os, sys; os.execv(os.path.dirname(sys.argv[1]) + "/common/pywrap", sys.argv)

# Run this with --help to see available options for tracing and debugging
# See https://github.com/cockpit-project/cockpit/blob/main/test/common/testlib.py
# "class Browser" and "class MachineCase" for the available API.

import testlib


# Nondestructive tests all run in the same running VM. This allows them to run in Packit, Fedora, and
# RHEL dist-git gating. They must not permanently change any file or configuration on the system in a
# way that influences other tests.
@testlib.nondestructive
class TestApplication(testlib.MachineCase):
    def testBasic(self):
        b = self.browser

        self.login_and_go("/diagnostics")
        b.wait_visible("#diagnostics-overview")
        b.wait_text("#diagnostics-overview", "Overview")
        b.wait_in_text(".pf-v6-c-card__title", "Failed units")

        b.click(".pf-v6-c-nav__link:contains('Boot')")
        b.wait_visible("#diagnostics-boot")
        b.wait_in_text("#diagnostics-boot", "Boot")
        b.wait_in_text(".pf-v6-c-card__title", "Total boot timing")
        b.wait_in_text(".pf-v6-c-alert__title", "Activation time is not the same as boot delay")

        b.click(".pf-v6-c-nav__link:contains('Crashes')")
        b.wait_visible("#diagnostics-crashes")
        b.wait_in_text("#diagnostics-crashes", "Crashes")

        b.click(".pf-v6-c-nav__link:contains('Findings')")
        b.wait_visible("#diagnostics-findings")
        b.wait_in_text("#diagnostics-findings", "Findings")

        b.click(".pf-v6-c-nav__link:contains('Security')")
        b.wait_visible("#diagnostics-security")
        b.wait_in_text("#diagnostics-security", "Security")
        b.wait_in_text(".pf-v6-c-alert__title", "not a vulnerability scan")

        b.click(".pf-v6-c-nav__link:contains('Verification')")
        b.wait_visible("#diagnostics-verification")
        b.wait_in_text("#diagnostics-verification", "Verification")

        b.click(".pf-v6-c-nav__link:contains('Overview')")
        b.wait_visible("#diagnostics-overview")

        b.set_window_size(390, 844)
        b.wait_visible("#diagnostics-overview")
        b.click(".pf-v6-c-nav__link:contains('Boot')")
        b.wait_visible("#diagnostics-boot")
        b.wait_in_text(".pf-v6-c-card__title", "Total boot timing")


if __name__ == '__main__':
    testlib.test_main()
